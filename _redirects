
# Redirect rules for Barlive

# Auth routes - Simplified password reset flow
/auth/reset-password /auth/reset-password 200
/auth/recuperar-password /auth/recuperar-password 200

# Legacy auth routes (redirect to new simplified routes)
/auth/reset-password-web /auth/reset-password 301
/auth/restablecer-password /auth/reset-password 301
/auth/recuperar-password-v6 /auth/recuperar-password 301
/auth/recuperar-password-v5 /auth/recuperar-password 301

# Other auth routes
/auth/login /auth/login 200
/auth/registro /auth/registro 200
/auth/callback /auth/callback 200

# Email confirmation
/email-confirmed /auth/email-confirmed 200

# Admin routes
/admin/* /admin/:splat 200

# Social routes
/social/* /social/:splat 200

# Profile routes
/perfil/* /perfil/:splat 200

# Legal routes
/legal/* /legal/:splat 200

# API routes (if any)
/api/* /api/:splat 200

# Fallback to index for SPA
/* /index.html 200
