{
  "expo": {
    "name": "BarLive",
    "slug": "bar-live-app-qvcija",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/ChatGPT Image 4 oct 2025, 00_01_43.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/ChatGPT Image 4 oct 2025, 00_01_43.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.barlive.app",
      "jsEngine": "hermes",
      "newArchEnabled": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/ChatGPT Image 4 oct 2025, 00_01_43.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.barlive.app",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "FOREGROUND_SERVICE",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "USE_FULL_SCREEN_INTENT"
      ],
      "googleServicesFile": "./google-services.json",
      "jsEngine": "hermes",
      "newArchEnabled": true,
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/final_quest_240x240.png",
          "color": "#14B8A6",
          "sounds": [
            "./assets/sounds/brindis.wav"
          ],
          "mode": "production",
          "androidMode": "default",
          "androidCollapsedTitle": "BarLive",
          "iosDisplayInForeground": true
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.barlive.app",
          "enableGooglePay": true,
          "setUrlSchemeOnAndroid": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24,
            "buildToolsVersion": "35.0.0",
            "packagingOptions": {
              "pickFirst": [
                "lib/x86/libc++_shared.so",
                "lib/x86_64/libc++_shared.so",
                "lib/armeabi-v7a/libc++_shared.so",
                "lib/arm64-v8a/libc++_shared.so"
              ]
            },
            "enableProguardInReleaseBuilds": true,
            "proguardRules": "-keep class com.stripe.** { *; }\n-keep class com.google.android.gms.wallet.** { *; }",
            "usesCleartextTraffic": false,
            "extraMavenRepos": [
              "https://maven.google.com",
              "https://repo1.maven.org/maven2"
            ],
            "extraGradleProperties": {
              "android.useAndroidX": "true",
              "android.enableJetifier": "true",
              "org.gradle.daemon": "false",
              "org.gradle.parallel": "true",
              "org.gradle.caching": "true",
              "org.gradle.jvmargs": "-Xmx4096m -XX:+HeapDumpOnOutOfMemoryError",
              "systemProp.http.keepAlive": "true",
              "systemProp.http.maxConnections": "50",
              "systemProp.networkTimeout": "600000",
              "systemProp.connectionTimeout": "300000",
              "systemProp.socketTimeout": "300000"
            }
          }
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "919b5976-08f5-4b6b-b35b-88d1cc737687"
      }
    },
    "scheme": "barlive",
    "experiments": {
      "typedRoutes": true
    },
    "notification": {
      "icon": "./assets/images/final_quest_240x240.png",
      "color": "#14B8A6",
      "androidMode": "default",
      "androidCollapsedTitle": "BarLive"
    },
    "owner": "jorgitopn"
  }
}