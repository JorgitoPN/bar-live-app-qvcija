{
  "expo": {
    "name": "BarLive",
    "slug": "BarLive",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/final_quest_240x240.png",
    "scheme": "barlive",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/final_quest_240x240.png",
      "resizeMode": "contain",
      "backgroundColor": "#6366f1"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.barlive.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Esta aplicaci\u00f3n necesita acceso a la c\u00e1mara para tomar fotos.",
        "NSPhotoLibraryUsageDescription": "Esta aplicaci\u00f3n necesita acceso a tu galer\u00eda de fotos.",
        "NSLocationWhenInUseUsageDescription": "Esta aplicaci\u00f3n necesita acceso a tu ubicaci\u00f3n para mostrarte locales cercanos.",
        "NSFaceIDUsageDescription": "Usamos Face ID para autenticaci\u00f3n segura."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/final_quest_240x240.png",
        "backgroundColor": "#6366f1"
      },
      "package": "com.barlive.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/final_quest_240x240.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#6366f1",
          "image": "./assets/images/final_quest_240x240.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "your-project-id"
      }
    }
  },
  "scheme": "BarLive"
}