
{
  "expo": {
    "name": "BarLive",
    "slug": "barlive",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/ChatGPT Image 4 oct 2025, 00_01_43.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/ChatGPT Image 4 oct 2025, 00_01_43.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.barlive.app",
      "jsEngine": "hermes",
      "newArchEnabled": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/ChatGPT Image 4 oct 2025, 00_01_43.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.barlive.app",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "FOREGROUND_SERVICE",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "USE_FULL_SCREEN_INTENT"
      ],
      "googleServicesFile": "./google-services.json",
      "jsEngine": "hermes",
      "newArchEnabled": true,
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/final_quest_240x240.png",
          "color": "#14B8A6",
          "sounds": [
            "./assets/sounds/brindis.wav"
          ],
          "mode": "production",
          "androidMode": "default",
          "androidCollapsedTitle": "BarLive",
          "iosDisplayInForeground": true
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {}
    },
    "scheme": "barlive",
    "experiments": {
      "typedRoutes": true
    },
    "notification": {
      "icon": "./assets/images/final_quest_240x240.png",
      "color": "#14B8A6",
      "androidMode": "default",
      "androidCollapsedTitle": "BarLive"
    },
    "owner": "jorgitopn"
  }
}
